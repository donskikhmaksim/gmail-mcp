# .env.example — переменные окружения gmail-mcp
#
# ВАЖНО: этот файл сейчас описывает только опциональный Telegram-approval
# слой (`src/tg_approval.ts` + `src/config.ts`'s `loadTgApprovalConfig`) —
# остальные переменные сервера (DATABASE_URL, GOOGLE_OAUTH_CLIENT_ID и т.д.)
# пока не сведены сюда в единый пример; актуальный полный список — в
# `src/config.ts` (там же и живые doc-комментарии по каждой).

# ── Опциональный Telegram-approval слой (второй фактор поверх обычного ─────
# ── consent-гейта "да"/"нет" в чате) ────────────────────────────────────────
#
# Что это: перед КАЖДОЙ гейтованной write-операцией (например, отправка
# письма) сервер, помимо обычного текстового подтверждения "да" в чате,
# может ещё и слать вам кнопки "✅ Подтвердить" / "🛑 Отклонить" в отдельный
# Telegram-бот — и не выполнит действие, пока вы не нажмёте кнопку САМИ.
# Это внеполосный (out-of-band) канал: текстовое "да" модель теоретически
# может сочинить сама себе, а нажатие кнопки в вашем собственном Telegram —
# нет.
#
# ВЫКЛЮЧЕНО ПО УМОЛЧАНИЮ. Если не задавать TG_APPROVAL_ENABLED (или явно
# оставить его "false") — форк ведёт себя ровно как без этой фичи вообще,
# никаких запросов к Telegram не уходит.
#
# ВАЖНОЕ ОГРАНИЧЕНИЕ: вебхук Telegram глобален на токен бота — только ОДИН
# физический сервер может владеть `/tg/webhook` для данного токена
# одновременно (второй `setWebhook` молча перезапишет первый). Если этот же
# бот-токен расшарен между несколькими вашими MCP-серверами (gmail/sheets/
# calendar/docs/drive-mcp + ticktick-mcp) — ровно ОДИН из них должен получить
# TG_WEBHOOK_OWNER=true (см. ниже); остальные держат его пустым/false и всё
# равно могут слать превью с кнопками через тот же бот (`notifyPlan`) и читать
# статус своих approval — просто не регистрируют вебхук сами.

# Включить фичу (true/false). По умолчанию false — секция ниже полностью
# необязательна, пока это не true.
TG_APPROVAL_ENABLED=false

# Токен бота от @BotFather (Telegram → BotFather → /newbot). Обязателен,
# когда TG_APPROVAL_ENABLED=true.
TG_BOT_TOKEN=

# Ваш личный Telegram chat_id (числом) — единственный chat_id, чьи нажатия
# кнопок вебхук примет; любой другой отправитель молча игнорируется. Узнать
# свой chat_id можно, например, у бота @userinfobot. Обязателен при
# TG_APPROVAL_ENABLED=true.
TG_OWNER_CHAT_ID=

# Секрет, который сервер укажет в setWebhook и будет сверять с заголовком
# X-Telegram-Bot-Api-Secret-Token на каждом входящем вебхуке — защита от
# поддельных вызовов на публичный /tg/webhook URL. Придумайте длинную
# случайную строку. Обязателен при TG_APPROVAL_ENABLED=true.
TG_APPROVAL_WEBHOOK_SECRET=

# Список инструментов (через запятую), для которых требуется подтверждение
# кнопкой в Telegram, например: gmail_send,gmail_forward. Пусто (не задано) =
# кнопка требуется для ВСЕХ уже гейтованных write-инструментов сервера.
TG_APPROVAL_TOOLS=

# Сколько живёт запрос на подтверждение в Telegram, в миллисекундах. После
# истечения TTL нажатие кнопки уже не засчитывается (в БД записи не
# происходит вовсе — WHERE ... AND expires_at > now() в consumeTgDecision),
# и повторная попытка исполнить действие получит отказ "истёк — построй план
# заново". По умолчанию 3600000 (1 час) — совпадает с дефолтным TTL обычного
# consent-плана (CONSENT_TTL_MS), можно задать своё независимо.
TG_APPROVAL_TTL_MS=3600000

# Публичный базовый URL, по которому этот сервер доступен снаружи — нужен,
# чтобы сервер сам зарегистрировал вебхук в Telegram при старте
# (`{PUBLIC_BASE_URL}/tg/webhook`). На Railway обычно достаточно оставить
# пустым — сервер сам подставит `https://${RAILWAY_PUBLIC_DOMAIN}`. Задавайте
# явно только для нестандартного домена/self-host вне Railway.
PUBLIC_BASE_URL=

# Владелец вебхука (true/false), по умолчанию false. Если TG_APPROVAL_ENABLED
# включён на ЭТОМ сервере, выставьте здесь true, чтобы он вызвал setWebhook и
# реально принимал нажатия кнопок — единственное исключение: несколько ваших
# MCP-серверов делят ОДИН TG_BOT_TOKEN (см. предупреждение выше), тогда true
# ставится РОВНО на одном из них, а на остальных остаётся false. При false
# сервер по-прежнему может слать превью с кнопками через тот же бот и читать
# статус собственных approval — просто не регистрирует вебхук сам.
TG_WEBHOOK_OWNER=false

# ВАЖНО про Postgres: раз вебхук теперь консюмит по manifest_id БЕЗ фильтра по
# серверу (consumeTgDecisionAnyServer), все 6 серверов (5 Google MCP уже сейчас
# смотрят на ОДИН физический Postgres через reseau.proxy.rlwy.net; ticktick-mcp
# при переносе этого кода тоже обязан подключиться туда же) должны реально
# писать/читать ОДНУ и ту же таблицу tg_approvals — иначе approval с другого
# сервера будет вечно висеть в PENDING (никто его не обработает).

# ── Опциональный побег из модели "один бот на все серверы" ─────────────────
#
# Токен ЭТОГО сервера. Когда задан — сервер полностью переходит на СВОЙ
# отдельный Telegram-бот: сам регистрирует /tg/webhook (не глядя на
# TG_WEBHOOK_OWNER), сам шлёт кнопки и сам же консюмит нажатия — только по
# СВОИМ манифестам (без общей "любой сервер" логики выше). TG_OWNER_CHAT_ID/
# TG_APPROVAL_WEBHOOK_SECRET/PUBLIC_BASE_URL по-прежнему обязательны при
# TG_APPROVAL_ENABLED=true — задайте их для ЭТОГО сервера как обычно (общий
# TG_APPROVAL_WEBHOOK_SECRET можно оставить как есть — секрет привязан к
# URL/боту конкретного сервера, коллизии между разными ботами на разных
# токенах он не создаёт; уникальный секрет — просто чуть больше defense-in-
# depth, не обязателен).
#
# ПУСТО ПО УМОЛЧАНИЮ = НИКАКИХ ИЗМЕНЕНИЙ: сервер продолжает работать на общем
# TG_BOT_TOKEN ровно как раньше. Откат — просто снять эту переменную, без
# редеплоя.
#
# ВНИМАНИЕ на gmail-mcp конкретно: этот сервер сегодня — вебхук-владелец
# общего бота (TG_WEBHOOK_OWNER=true) для остальных 5. Если когда-нибудь
# задать TG_BOT_TOKEN_OVERRIDE именно здесь, НЕ снимая TG_WEBHOOK_OWNER —
# сервер перейдёт на свой бот и перестанет обслуживать общий вебхук для
# остальных (см. громкое предупреждение в логах при старте). В этом случае
# переставьте TG_WEBHOOK_OWNER=true на другой сервер, оставшийся на общем боте.
TG_BOT_TOKEN_OVERRIDE=
